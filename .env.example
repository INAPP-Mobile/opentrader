########## SHARED ##########

# Port the web UI / API listens on.
# NOTE: pinned to 4000 in the Dockerfile CMD (export PORT=4000) — Railway injects
# PORT=8080 on services without an explicit PORT var, which breaks the domain mapping.
PORT=4000

# Bind address. MUST be 0.0.0.0 in containerized deployments (default is localhost)
HOST=0.0.0.0

# SQLite database file (persisted on the /app/data volume).
# Uses the Railway volume mount path reference when available.
DATABASE_URL=file:/app/data/opentrader.db

# Admin password used to log into the OpenTrader UI (user: onboarding@opentrader.pro).
# On Railway templates this is auto-generated via ${{secret(16)}} — copy the generated
# value from the service's Variables tab after deploy.
ADMIN_PASSWORD=change-me

# Logging level for ccxt ("true" to enable, empty to disable)
CCXT_VERBOSE=

# Full path to a directory with custom strategy files (optional)
CUSTOM_STRATEGIES_PATH=